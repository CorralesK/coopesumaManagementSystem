        <mxCell id="notes-content" value="• &lt;b&gt;Arquitectura:&lt;/b&gt; Monolítica en 3 capas (Presentación, Aplicación, Datos)&lt;br&gt;• &lt;b&gt;Patrón:&lt;/b&gt; MVC + Repository Pattern&lt;br&gt;• &lt;b&gt;Comunicación:&lt;/b&gt; API REST con JSON&lt;br&gt;• &lt;b&gt;Autenticación:&lt;/b&gt; OAuth 2.0 (Microsoft 365) + JWT&lt;br&gt;• &lt;b&gt;Base de Datos:&lt;/b&gt; PostgreSQL 14+ (Relacional)&lt;br&gt;• &lt;b&gt;Frontend:&lt;/b&gt; React 18 + Vite (SPA)&lt;br&gt;• &lt;b&gt;Backend:&lt;/b&gt; Node.js 18+ + Express.js&lt;br&gt;• &lt;b&gt;Seguridad:&lt;/b&gt; HTTPS, CORS, JWT, Validación Joi, SQL Injection Protection&lt;br&gt;• &lt;b&gt;Logging:&lt;/b&gt; Winston (archivos rotativos)&lt;br&gt;• &lt;b&gt;Testing:&lt;/b&gt; Jest (Unit + Integration tests)" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="400" y="1520" width="680" height="130" as="geometry" />
        </mxCell>

